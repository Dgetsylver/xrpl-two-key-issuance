{
  "name": "xrpl-token",
  "version": "0.1.0",
  "private": true,
  "description": "Simple XRPL fungible token (MPToken) with multisig-gated issuer and governance accounts.",
  "type": "module",
  "scripts": {
    "devnet:up": "tsx devnet/cli.ts up",
    "devnet:down": "tsx devnet/cli.ts down",
    "setup:issuer": "tsx src/scripts/setup-issuer.ts",
    "setup:governance": "tsx src/scripts/setup-governance.ts",
    "mint": "tsx src/scripts/mint.ts",
    "redistribute": "tsx src/scripts/redistribute.ts",
    "status": "tsx src/scripts/status.ts",
    "web:sync-config": "tsx src/scripts/sync-public-config.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:typecheck": "npm --prefix web run typecheck",
    "test:integration": "vitest run",
    "typecheck": "tsc --noEmit && npm run web:typecheck"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "xrpl": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "testcontainers": "^10.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
