---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Propose a Mint">
  <div class="inline-disclaimer">
    Minting is a 2-of-3 multisig action on the issuer account. Connect with an address on the issuer's signer list to
    propose and sign the first signature.
  </div>

  <section class="card">
    <h2>Propose a mint</h2>
    <p id="connect-status">Not connected.</p>
    <button id="connect-button" type="button">Connect with GhostSig</button>

    <div id="history-area" style="margin-top: 1rem;"></div>

    <form id="mint-form" style="margin-top: 1rem; display:none;">
      <div class="field">
        <label for="mint-amount">Amount to mint (Gton)</label>
        <input id="mint-amount" name="amount" placeholder="0" required />
      </div>
      <div class="field">
        <label for="mint-period">Period label (e.g. a year)</label>
        <input id="mint-period" name="period" required />
      </div>
      <button type="submit">Sign proposal</button>
    </form>
  </section>

  <section class="card" id="result-card" style="display:none;">
    <h2>Result</h2>
    <div id="result-body"></div>
  </section>
</Layout>

<script>
  import { loadPublicConfig, isIssuerSigner, requireIssuer, requireGovernance, requireMptIssuanceId } from '../lib/config'
  import { ghostsigConnect, GhostsigError } from '../lib/ghostsig'
  import { buildProposalPaymentTx } from '../lib/tx'
  import { signCeremonyPayload, buildHandoffMessage } from '../lib/ceremony'
  import { describePaymentTx } from '../lib/preview'
  import { getMintHistory, suggestNextMintPeriod } from '../lib/xrplClient'
  import { toGton, fromGton } from '../lib/gton'
  import QRCode from 'qrcode'

  const connectButton = document.getElementById('connect-button') as HTMLButtonElement
  const connectStatus = document.getElementById('connect-status')!
  const historyArea = document.getElementById('history-area')!
  const mintForm = document.getElementById('mint-form') as HTMLFormElement
  const periodInput = document.getElementById('mint-period') as HTMLInputElement
  const resultCard = document.getElementById('result-card')!
  const resultBody = document.getElementById('result-body')!

  function statusMessage(el: HTMLElement, kind: 'info' | 'success' | 'error', text: string) {
    el.innerHTML = `<div class="status-message ${kind}">${text}</div>`
  }

  let connectedAddress: string | undefined

  async function main() {
    const config = await loadPublicConfig()
    const issuer = requireIssuer(config)
    const governance = requireGovernance(config)
    const mptIssuanceId = requireMptIssuanceId(config)

    try {
      const history = await getMintHistory(issuer.address)
      periodInput.value = suggestNextMintPeriod(history)
      if (history.length > 0) {
        const rows = history
          .map((r) => `<tr><td>${r.period}</td><td>${toGton(r.amountRaw)} ${config.token.ticker}</td></tr>`)
          .join('')
        historyArea.innerHTML = `<p style="font-family: system-ui, sans-serif; font-size: 0.85rem;"><strong>Previous mints on record:</strong></p><table style="width:100%; font-family: system-ui, sans-serif; font-size: 0.85rem;"><thead><tr><th style="text-align:left;">Period</th><th style="text-align:left;">Amount</th></tr></thead><tbody>${rows}</tbody></table>`
      }
    } catch {
      periodInput.value = String(new Date().getFullYear())
    }

    connectButton.addEventListener('click', async () => {
      connectButton.disabled = true
      try {
        const { address } = await ghostsigConnect()
        connectedAddress = address
        if (isIssuerSigner(config, address)) {
          connectStatus.innerHTML = `Connected as <span class="mono address">${address}</span> — recognized issuer signer.`
        } else {
          statusMessage(
            connectStatus,
            'error',
            `Connected as <span class="mono address">${address}</span> — this address is not on the issuer's published signer list. GhostSig will refuse to sign for the issuer account unless it's on the account's live SignerList.`,
          )
        }
        mintForm.style.display = 'block'
      } catch (err) {
        const message = err instanceof GhostsigError ? err.message : err instanceof Error ? err.message : String(err)
        statusMessage(connectStatus, 'error', message)
      } finally {
        connectButton.disabled = false
      }
    })

    mintForm.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (!connectedAddress) return
      const formData = new FormData(mintForm)
      const amountInput = String(formData.get('amount') ?? '').trim()
      const period = String(formData.get('period') ?? '').trim()
      const submitButton = mintForm.querySelector('button[type="submit"]') as HTMLButtonElement
      submitButton.disabled = true
      try {
        const amountRaw = fromGton(amountInput)
        const tx = await buildProposalPaymentTx(issuer.address, governance.address, mptIssuanceId, amountRaw, issuer.quorum, {
          type: 'mint-period',
          data: period,
        })
        const preview = describePaymentTx(tx, config.token.ticker, issuer.address, governance.address)
        const outcome = await signCeremonyPayload(tx, connectedAddress)
        resultCard.style.display = 'block'
        if (outcome.status === 'submitted') {
          statusMessage(resultBody, 'success', `${preview.summary} Submitted! (tx hash <span class="mono">${outcome.hash}</span>)`)
        } else if (outcome.status === 'handoff') {
          const message = buildHandoffMessage(preview, outcome.shareUrl)
          resultBody.innerHTML = `
            <div class="status-message info">${preview.summary} Your signature was added, but quorum (${issuer.quorum}) hasn't been met yet.</div>
            <p>Relay this link to another issuer signer:</p>
            <div class="field"><input readonly value="${message}" id="handoff-message" /></div>
            <button type="button" id="copy-handoff">Copy message</button>
            <div class="qr-wrapper"><img id="handoff-qr" alt="QR code linking to the sign page" /></div>
          `
          const qrImg = document.getElementById('handoff-qr') as HTMLImageElement
          qrImg.src = await QRCode.toDataURL(outcome.shareUrl)
          document.getElementById('copy-handoff')!.addEventListener('click', async () => {
            await navigator.clipboard.writeText(message)
          })
        } else {
          statusMessage(resultBody, 'error', outcome.message)
        }
      } catch (err) {
        resultCard.style.display = 'block'
        statusMessage(resultBody, 'error', err instanceof Error ? err.message : String(err))
      } finally {
        submitButton.disabled = false
      }
    })
  }

  main().catch((err) => {
    statusMessage(connectStatus, 'error', err instanceof Error ? err.message : String(err))
  })
</script>
