---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Propose a Disbursement">
  <div class="inline-disclaimer">
    A disbursement is a 2-of-3 multisig action on the governance account. Connect with an address on governance's
    signer list to propose and sign the first signature.
  </div>

  <section class="card">
    <h2>Propose a disbursement</h2>
    <p id="connect-status">Not connected.</p>
    <button id="connect-button" type="button">Connect with GhostSig</button>

    <form id="disbursement-form" style="margin-top: 1rem; display:none;">
      <div class="field">
        <label for="disbursement-destination">Destination address</label>
        <input id="disbursement-destination" name="destination" placeholder="r..." required />
      </div>
      <div class="field">
        <label for="disbursement-amount">Amount (Gton)</label>
        <input id="disbursement-amount" name="amount" placeholder="0" required />
      </div>
      <button type="submit">Sign proposal</button>
    </form>
  </section>

  <section class="card" id="result-card" style="display:none;">
    <h2>Result</h2>
    <div id="result-body"></div>
  </section>
</Layout>

<script>
  import { loadPublicConfig, isGovernanceSigner, requireGovernance, requireMptIssuanceId } from '../lib/config'
  import { ghostsigConnect, GhostsigError } from '../lib/ghostsig'
  import { buildProposalPaymentTx } from '../lib/tx'
  import { signCeremonyPayload, buildHandoffMessage } from '../lib/ceremony'
  import { describePaymentTx } from '../lib/preview'
  import { fromGton } from '../lib/gton'
  import QRCode from 'qrcode'

  const connectButton = document.getElementById('connect-button') as HTMLButtonElement
  const connectStatus = document.getElementById('connect-status')!
  const disbursementForm = document.getElementById('disbursement-form') as HTMLFormElement
  const resultCard = document.getElementById('result-card')!
  const resultBody = document.getElementById('result-body')!

  function statusMessage(el: HTMLElement, kind: 'info' | 'success' | 'error', text: string) {
    el.innerHTML = `<div class="status-message ${kind}">${text}</div>`
  }

  let connectedAddress: string | undefined

  async function main() {
    const config = await loadPublicConfig()
    const governance = requireGovernance(config)
    const mptIssuanceId = requireMptIssuanceId(config)

    connectButton.addEventListener('click', async () => {
      connectButton.disabled = true
      try {
        const { address } = await ghostsigConnect()
        connectedAddress = address
        if (isGovernanceSigner(config, address)) {
          connectStatus.innerHTML = `Connected as <span class="mono address">${address}</span> — recognized governance signer.`
        } else {
          statusMessage(
            connectStatus,
            'error',
            `Connected as <span class="mono address">${address}</span> — this address is not on governance's published signer list. GhostSig will refuse to sign for the governance account unless it's on the account's live SignerList.`,
          )
        }
        disbursementForm.style.display = 'block'
      } catch (err) {
        const message = err instanceof GhostsigError ? err.message : err instanceof Error ? err.message : String(err)
        statusMessage(connectStatus, 'error', message)
      } finally {
        connectButton.disabled = false
      }
    })

    disbursementForm.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (!connectedAddress) return
      const formData = new FormData(disbursementForm)
      const destination = String(formData.get('destination') ?? '').trim()
      const amountInput = String(formData.get('amount') ?? '').trim()
      const submitButton = disbursementForm.querySelector('button[type="submit"]') as HTMLButtonElement
      submitButton.disabled = true
      try {
        const amountRaw = fromGton(amountInput)
        const tx = await buildProposalPaymentTx(governance.address, destination, mptIssuanceId, amountRaw, governance.quorum)
        const preview = describePaymentTx(tx, config.token.ticker, config.issuer?.address, governance.address)
        const outcome = await signCeremonyPayload(tx, connectedAddress)
        resultCard.style.display = 'block'
        if (outcome.status === 'submitted') {
          statusMessage(resultBody, 'success', `${preview.summary} Submitted! (tx hash <span class="mono">${outcome.hash}</span>)`)
        } else if (outcome.status === 'handoff') {
          const message = buildHandoffMessage(preview, outcome.shareUrl)
          resultBody.innerHTML = `
            <div class="status-message info">${preview.summary} Your signature was added, but quorum (${governance.quorum}) hasn't been met yet.</div>
            <p>Relay this link to another governance signer:</p>
            <div class="field"><input readonly value="${message}" id="handoff-message" /></div>
            <button type="button" id="copy-handoff">Copy message</button>
            <div class="qr-wrapper"><img id="handoff-qr" alt="QR code linking to the sign page" /></div>
          `
          const qrImg = document.getElementById('handoff-qr') as HTMLImageElement
          qrImg.src = await QRCode.toDataURL(outcome.shareUrl)
          document.getElementById('copy-handoff')!.addEventListener('click', async () => {
            await navigator.clipboard.writeText(message)
          })
        } else {
          statusMessage(resultBody, 'error', outcome.message)
        }
      } catch (err) {
        resultCard.style.display = 'block'
        statusMessage(resultBody, 'error', err instanceof Error ? err.message : String(err))
      } finally {
        submitButton.disabled = false
      }
    })
  }

  main().catch((err) => {
    statusMessage(connectStatus, 'error', err instanceof Error ? err.message : String(err))
  })
</script>
